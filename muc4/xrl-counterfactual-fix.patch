+    def _build_dice_explainer(self, repr_names):
+        """Build the DiCE explainer for counterfactual() from replay data.
+
+        Returns (state_features, explainer). State features are all replay
+        columns except the trailing action column; the action column is
+        the DiCE outcome. If repr_names was not given, fall back to
+        state_0..state_{n-1} + 'action' (infer_DBN's own default is
+        integer names, which DiCE cannot use as feature names).
+        """
+        states, actions, _rewards, _states_new = self.replay_buffer
+        states = convert_and_expand(states).astype(float)
+        actions = convert_and_expand(actions).astype(float).ravel()
+        n_states = states.shape[1]
+        if repr_names is None:
+            names = [f"state_{i}" for i in range(n_states)] + ["action"]
+        else:
+            names = list(repr_names)
+            assert len(names) == n_states + 1, (
+                "repr_names must cover states + action: "
+                f"got {len(names)}, need {n_states + 1}")
+        state_features = names[:-1]
+        # NOTE: counterfactual() and its helpers hard-code the outcome
+        # column name 'action' (cf_df.drop(['action']), ...). The DiCE
+        # dataframe therefore always uses 'action' as its last column,
+        # whatever repr_names calls it (the notebook uses 'push'); the
+        # causal graph built by infer_DBN still uses repr_names.
+        df = pd.DataFrame(
+            np.concatenate([states, actions[:, None]], axis=1),
+            columns=state_features + ["action"])
+        df["action"] = df["action"].astype(int)
+        dice_data = dice_ml.Data(
+            dataframe=df, continuous_features=state_features,
+            outcome_name="action")
+        dice_model = dice_ml.Model(model=self.pi, backend="sklearn")
+        return state_features, Dice(dice_data, dice_model, method="random")
+
 
